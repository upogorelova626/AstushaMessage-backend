
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChatType {
  PRIVATE
  GROUP
}

enum MessageType {
  TEXT
  SYSTEM
}

model Chat {
  id         String   @id @default(uuid())
  type       ChatType @default(PRIVATE)
  title      String?
  privateKey String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants   ChatParticipant[]
  messages       Message[]
  pinnedMessages MessagePin[]
  folderItems    ChatFolderItem[]
}

model ChatParticipant {
  chatId String
  userId String

  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?
  isMarkedUnread Boolean  @default(false)

  isArchived Boolean @default(false)
  isPinned   Boolean @default(false)
  isFavorite Boolean @default(false)

  isMuted    Boolean   @default(false)
  mutedUntil DateTime?

  deletedAt DateTime?
  clearedAt DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
}

model Message {
  id       String      @id @default(uuid())
  chatId   String
  senderId String
  text     String
  type     MessageType @default(TEXT)

  isPinned    Boolean   @default(false)
  pinnedAt    DateTime?
  pinnedUntil DateTime?
  pinnedById  String?

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  chat      Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  favorites MessageFavorite[]
  pin       MessagePin?

  @@index([chatId, createdAt])
}

model MessageFavorite {
  messageId String
  userId    String

  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model MessagePin {
  messageId  String @id
  chatId     String
  pinnedById String

  pinnedAt  DateTime @default(now())
  expiresAt DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, pinnedAt(sort: Desc)])
  @@index([expiresAt])
}

model ChatFolder {
  id     String @id @default(uuid())
  userId String
  name   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ChatFolderItem[]

  @@unique([userId, name])
  @@index([userId])
}

model ChatFolderItem {
  folderId String
  chatId   String

  addedAt DateTime @default(now())

  folder ChatFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  chat   Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([folderId, chatId])
  @@index([chatId])
}
